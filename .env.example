# Copy to `.env` in the repo root. Never commit `.env`.
#
# Create a CLI identity (does not print the secret here):
#   stellar keys generate agentguard-deployer --network testnet --fund
#
# Fund it: https://laboratory.stellar.org/#account-creator?network=testnet

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Named Stellar CLI identity (not a raw secret)
STELLAR_IDENTITY=agentguard-deployer
# Set after initialize, for invoke scripts
# AGENTGUARD_CONTRACT_ID=C...
